# Local development configuration
# For deployment, these are set by scripts/deploy_services.sh

# Vertex AI (Flo uses gemini-3.5-flash on the global endpoint)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=leadsy-flock
GOOGLE_CLOUD_LOCATION=global
GCP_REGION=asia-south1

# Campaign runtime (scripts/provision_infra.sh)
CAMPAIGN_STEPS_TOPIC=campaign-steps
CAMPAIGN_STEPS_DLQ_TOPIC=campaign-steps-dlq
FOUNDER_ALERTS_TOPIC=founder-alerts
MEDIA_BUCKET_NAME=leadsy-flock-media-asia-south1
LOGS_BUCKET_NAME=leadsy-flock-logs-asia-south1
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE=leadsy-inbound

# Optional — filled by scripts/register_runtime.py when Agent Engine is available
# MEMORY_BANK_ID=
# MEMORY_BANK_LOCATION=us-central1

# Optional — Telegram meeting + founder ops (set on flock-api after deploy)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOW_USER_IDS=
# OPS_TOKEN=
# USD_INR=85
