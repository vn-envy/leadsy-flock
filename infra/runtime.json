  "region": "asia-south1",
  "vertexRuntimeRegion": "us-central1",
  "serviceAccount": "leadsy-agent@leadsy-flock.iam.gserviceaccount.com",
  "pubsubPushServiceAccount": "leadsy-pubsub-push@leadsy-flock.iam.gserviceaccount.com",
  "topics": {
    "campaignSteps": "campaign-steps",
    "campaignStepsDlq": "campaign-steps-dlq",
